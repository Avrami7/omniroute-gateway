# Port the gateway HTTP server listens on.
PORT=3000

# Bearer token clients must send as `Authorization: Bearer <value>` to use the
# gateway. Required — an unauthenticated proxy in front of paid API keys is a
# real abuse/cost risk. Generate a long random value, e.g. `openssl rand -hex 32`.
GATEWAY_API_KEY=

# Provider API keys. Only configure the providers you actually want routed —
# any model prefix mapped in src/config/routing.ts to a provider whose key is
# missing here will cause the gateway to fail fast at startup.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# One of: debug, info, warn, error
LOG_LEVEL=info
